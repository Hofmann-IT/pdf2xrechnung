# Umgebungsdatei für den systemd-Dienst: nach /etc/pdf-zu-erechnung/env kopieren, Rechte 600.
# Nur hier stehen Zugangsdaten – niemals in config/application.yaml.
SMTP_USERNAME=
SMTP_PASSWORD=
# Anmeldung für den Verwaltungsbereich (/verwaltung); leer = Bereich gesperrt
ADMIN_PASSWORD=
# Optional: Speicher und JVM-Optionen
JAVA_OPTS=-Xmx1g -XX:+UseSerialGC -Dfile.encoding=UTF-8
