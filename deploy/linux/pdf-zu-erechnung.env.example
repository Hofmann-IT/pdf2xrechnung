# Umgebungsdatei für den systemd-Dienst: nach /etc/pdf-zu-erechnung/env kopieren, Rechte 600.
# Nur hier stehen Zugangsdaten – niemals in config/application.yaml.
SMTP_USERNAME=
SMTP_PASSWORD=
# Optionaler Betreiber-Zugang (Benutzer admin, Administratorrechte); leer = kein Betreiber-Zugang.
# Benutzerkonten werden in der Oberfläche unter Verwaltung -> Benutzer angelegt.
ADMIN_PASSWORD=
# Netzzugriff: Standard ist nur dieser Computer (HTTP auf 127.0.0.1) - passend für einen Reverse
# Proxy mit TLS auf demselben Server. Nur wenn der Proxy auf einem anderen Rechner läuft:
#APP_NETWORK_MODE=open
# Optional: Speicher und JVM-Optionen
JAVA_OPTS=-Xmx1g -XX:+UseSerialGC -Dfile.encoding=UTF-8
