<?xml version="1.0" encoding="UTF-8"?>
<!--
  PDF-zu-E-Rechnung Converter & E-Rechnungs-Validator (On-Premises)

  Verbindlicher Stack (siehe Projektvorgabe, Abschnitt 3):
    Java 21 LTS, Spring Boot 3.x, Maven,
    Apache PDFBox 3.x, Mustangproject, KoSIT-Validator,
    SQLite + Spring JDBC + Flyway (kein JPA/Hibernate),
    Spring MVC + Thymeleaf + HTMX,
    SLF4J/Logback, JUnit 5 + AssertJ.

  Versionsentscheidungen (alle am 2026-09-24 gegen Maven Central verifiziert):
    - Spring Boot 3.5.16   : höchste 3.x-Version (4.x ist NICHT Teil des verbindlichen Stacks).
    - Mustang 2.17.0       : aktuellste Version von org.mustangproject:library.
    - PDFBox 3.0.5         : bewusst NICHT die neueste 3.0.x, sondern exakt die Version,
                             gegen die Mustang 2.17.0 gebaut ist (org.apache.pdfbox:pdfbox:3.0.5),
                             um Binärinkompatibilitäten zwischen Mustang und PDFBox auszuschließen.
    - KoSIT validationtool 1.5.0 : aktuellste Version von de.kosit:validationtool.
    - sqlite-jdbc, Flyway, Thymeleaf, Logback, JUnit, AssertJ: von Spring Boot verwaltete Versionen.
    - Saxon-HE 12.4        : Mustang 2.17.0 bringt Saxon-HE 12.4 mit, KoSIT 1.5.0 wurde gegen 11.4
                             gebaut. Es kann nur EINE Saxon-Version auf dem Classpath liegen. Die
                             höhere Version wird hier explizit festgeschrieben; die Verträglichkeit
                             mit dem KoSIT-Validator wird in Phase 3 durch Tests nachgewiesen
                             (siehe docs/adr/0002-validator-einbindung.md).

  Freigaben vom 2026-09-24 (Phase 2), Details in docs/adr/0002-validator-einbindung.md:
    - org.mustangproject:validator (ZUGFeRD-/PDF/A-Validierung): veraPDF wird unter der
      MPL-2.0-Option der Dual-Lizenz (GPLv3 / MPL 2.0) genutzt.
    - javax.xml.bind:jaxb-api 2.3.1, com.sun.xml.bind:jaxb-impl 2.3.9 und
      org.apache.commons:commons-lang3: Laufzeitabhängigkeiten von de.kosit:validationtool 1.5.0,
      die in dessen veröffentlichtem POM nicht deklariert sind.

  Test-Scope (Phase 4): com.icegreen:greenmail-junit5 (Apache 2.0) für den SMTP-Versandtest.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>de.hofmannit</groupId>
    <artifactId>pdf-zu-erechnung</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>PDF-zu-E-Rechnung</name>
    <description>On-Premises PDF-zu-E-Rechnung Converter und E-Rechnungs-Validator (XRechnung, ZUGFeRD/Factur-X)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <pdfbox.version>3.0.5</pdfbox.version>
        <mustang.version>2.17.0</mustang.version>
        <kosit-validationtool.version>1.5.0</kosit-validationtool.version>
        <saxon.version>12.4</saxon.version>
        <jaxb2.api.version>2.3.1</jaxb2.api.version>
        <jaxb2.runtime.version>2.3.9</jaxb2.runtime.version>
        <htmx.version>2.0.6</htmx.version>
        <greenmail.version>2.1.14</greenmail.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Genau eine Saxon-Version auf dem Classpath (Mustang: 12.4, KoSIT: 11.4). -->
            <dependency>
                <groupId>net.sf.saxon</groupId>
                <artifactId>Saxon-HE</artifactId>
                <version>${saxon.version}</version>
            </dependency>
            <!-- Genau eine PDFBox-Version auf dem Classpath (identisch mit Mustang-Build). -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>preflight</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ===== Spring Boot (Web, Thymeleaf, JDBC) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ===== Persistenz: SQLite + Flyway (kein JPA, kein Hibernate) ===== -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- ===== PDF-Verarbeitung ===== -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <exclusions>
                <!-- Spring Boot liefert die Commons-Logging-API über spring-jcl; ein zweites
                     commons-logging.jar erzeugt Konflikte (Warnung beim Start). -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ===== E-Rechnung: Mustangproject (ZUGFeRD/Factur-X/XRechnung, CII + UBL) ===== -->
        <dependency>
            <groupId>org.mustangproject</groupId>
            <artifactId>library</artifactId>
            <version>${mustang.version}</version>
            <exclusions>
                <!-- commons-logging kommt transitiv über Apache FOP; API wird von spring-jcl bereitgestellt. -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ===== Validierung: Mustang-Validator (ZUGFeRD/Factur-X, PDF/A über veraPDF) =====
             veraPDF ist dual-lizenziert (GPLv3 / MPL 2.0); Nutzung unter MPL 2.0 am 2026-09-24
             freigegeben (siehe docs/adr/0002-validator-einbindung.md). -->
        <dependency>
            <groupId>org.mustangproject</groupId>
            <artifactId>validator</artifactId>
            <version>${mustang.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ===== Validierung: KoSIT-Validator als lokale Java-Bibliothek =====
             Das veröffentlichte POM deklariert die Laufzeitabhängigkeiten nicht; sie werden
             hier explizit ergänzt (Freigabe 2026-09-24): JAXB 2 (javax.xml.bind) und commons-lang3.
             Saxon-HE, commons-io und slf4j sind bereits über Mustang/Spring vorhanden. -->
        <dependency>
            <groupId>de.kosit</groupId>
            <artifactId>validationtool</artifactId>
            <version>${kosit-validationtool.version}</version>
        </dependency>
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>${jaxb2.api.version}</version>
            <exclusions>
                <!-- javax.activation-Klassen kommen über com.sun.activation:jakarta.activation (jaxb-impl). -->
                <exclusion>
                    <groupId>javax.activation</groupId>
                    <artifactId>javax.activation-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- JAXB-2-Implementierung bewusst als com.sun.xml.bind:jaxb-impl (eigene Koordinaten),
             NICHT org.glassfish.jaxb:jaxb-runtime 2.x: Letzteres würde per Maven-Konfliktauflösung
             die von Mustang benötigte jaxb-runtime 4.x (Jakarta) verdrängen. Beide Implementierungen
             liegen in unterschiedlichen Packages und koexistieren. -->
        <dependency>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-impl</artifactId>
            <version>${jaxb2.runtime.version}</version>
            <exclusions>
                <!-- jakarta.xml.bind-api 2.3.x enthält javax-Packages und würde mit der von Mustang
                     benötigten jakarta.xml.bind-api 4.x kollidieren; die javax-API kommt aus jaxb-api 2.3.1. -->
                <exclusion>
                    <groupId>jakarta.xml.bind</groupId>
                    <artifactId>jakarta.xml.bind-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- ===== Web-UI: HTMX (lokal ausgeliefert als WebJar, kein CDN) ===== -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>htmx.org</artifactId>
            <version>${htmx.version}</version>
        </dependency>

        <!-- ===== Tests: JUnit 5 + AssertJ (über spring-boot-starter-test) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- GreenMail (Apache 2.0): lokaler SMTP-Server für den Versandtest (Vorgabe Phase 4). -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>${greenmail.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Stabiler Artefaktname für Dienst-/Container-Konfigurationen (WinSW, systemd, Dockerfile). -->
        <finalName>pdf-zu-erechnung</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Stellt META-INF/build-info.properties bereit (Anwendungsversion für Ledger/Run). -->
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
